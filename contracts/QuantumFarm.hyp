// SPDX-License-Identifier: MIT
pragma hyperion >=0.0.1;

import "./lib/openzeppelin/token/ERC721/IERC721Receiver.hyp";
import "./lib/openzeppelin/access/Ownable.hyp";
import "./lib/openzeppelin/security/Pausable.hyp";
import "./lib/openzeppelin/security/ReentrancyGuard.hyp";
import "./lib/CommitReveal.hyp";
import "./lib/Ops.hyp";

import "./interfaces/ISquirrelGame.hyp";
import "./interfaces/ITraitStats.hyp";
import "./SquirrelGame.hyp";
import "./QBTC.hyp";

/**
 * QuantumFarm — the operations layer.
 *
 *   Farm: Quantum Rigs mine qBTC. They wear out, need coolant, and stop
 *         earning the moment either runs out.
 *   Drey: Squirrels take a cut of that yield, gated on acorn energy.
 *
 * Emission is a fixed network budget split pro-rata by live hashrate, decaying
 * 4% per 30-day season. Per-rig rate therefore falls as more rigs join, which
 * is what lets a hard 21,000,000 cap coexist with an open player count — a
 * flat per-rig rate would exhaust the cap in days at full participation.
 *
 * Yield settles into `credit`: spendable inside the game the instant it is
 * earned, never transferable. Turning credit into ERC-20 qBTC is a separate,
 * deliberate act — `requestWithdraw` then `settleWithdraw` — which pays a
 * guaranteed floor that grows over three days plus a 50/50 draw on the rest.
 *
 * The earlier design vested at claim time and restarted the clock on every
 * settlement, which meant an active player could never reach a full payout and
 * could not spend a single qBTC of what they had mined. Both defects are the
 * same defect: the lock was attached to earning rather than to leaving.
 */
contract QuantumFarm is Ownable, IERC721Receiver, Pausable, ReentrancyGuard {
    using CommitReveal for uint64;

    /* ------------------------------------------------------------ TYPES */

    /// @dev packs into exactly two slots
    struct Rig {
        address owner;        // 160
        uint16 tokenId;       //  16
        uint8 durability;     //   8
        uint40 lastSettled;   //  40
        uint32 streakDays;    //  32  -> 256
        uint40 fuelExpiry;    //  40
        uint40 lastStreakDay; //  40
        uint40 stakedAt;      //  40
        uint128 rewardDebt;   // 128  -> 248, accPerHash watermark
    }

    struct Guard {
        address owner;        // 160
        uint16 tokenId;       //  16
        uint8 energy;         //   8
        uint40 lastSettled;   //  40
        uint32 patchSeason;   //  32 -> 256
        uint128 taxDebt;      // qbtcPerAlpha watermark
    }

    /// @dev pending unstake; the 50/50 roll is pledged a block ahead
    struct ExitCommit {
        uint16[] tokenIds;
        uint64 revealBlock;
        uint256 salt;
    }

    /**
     * A credit balance on its way out to the ERC-20.
     *
     * `start` is the odds clock and is written exactly once, by
     * `requestWithdraw`. `revealBlock` is the randomness anchor and is
     * re-takeable, because block hashes survive only 256 blocks (~4.3 h) while
     * the odds clock runs for three days. Conflating the two would make the
     * curve decorative — see lib/CommitReveal.hyp.
     */
    struct Withdrawal {
        uint128 amount;
        uint40 start;
        uint64 revealBlock;
        uint256 salt;
    }

    /* -------------------------------------------------------- CONSTANTS */

    uint8 public constant MAX_ALPHA = 8;
    uint8 public constant ALPHA_RANKS = 3;
    uint256 public constant MINIMUM_TO_EXIT = 2 days;

    /**
     * Withdrawal terms.
     *
     * A guaranteed floor rising 0% -> 60% over three days, plus a fixed 50/50
     * draw on whatever the floor does not already cover. Expected value runs
     * 50% at once to 80% after the full window, and a player who waits can no
     * longer be zeroed — the all-or-nothing version could, which reads as the
     * app deleting a balance rather than as a bet.
     *
     *   EV = floor + 0.5 * (1 - floor)
     *
     * WITHDRAW_FLOOR_START is deliberately zero: drawing immediately keeps a
     * zero outcome, because that is the impatient path. Raising it lifts EV(0)
     * with it, which is one constant if that trade is ever wanted.
     */
    uint256 public constant WITHDRAW_WINDOW = 3 days;
    uint256 public constant WITHDRAW_FLOOR_START = 0;
    uint256 public constant WITHDRAW_FLOOR_END = 6000;
    uint256 public constant WITHDRAW_DRAW_BPS = 5000;
    /**
     * Half of a lost draw is burned, half feeds the Drey.
     *
     * Paying the whole loss to the Drey — which is what `executeExit` used to
     * do — hands a whale a better withdrawal rate than everyone else, since
     * `qbtcPerAlpha` refunds them their own share of their own loss. At 80% of
     * the staked alpha that is an effective 90% rate against a small player's
     * 50%. Splitting halves the edge, down to 65%, while squirrels keep earning
     * from other people's impatience.
     */
    uint256 public constant WITHDRAW_LOSS_BURN_BPS = 5000;
    /// @dev bounds what a validator could win by biasing one reveal slot
    uint256 public constant MAX_WITHDRAW_PER_DRAW = 5000 ether;
    /// @dev forces tranches, which pulls a realised outcome toward its EV
    uint256 public constant MAX_WITHDRAW_SHARE_BPS = 2500;

    /**
     * Onboarding grant, released on progress rather than all at once.
     *
     * `mapping(address => bool) started` stops one address claiming twice and
     * does nothing about one person using two thousand addresses, so the grant
     * is a voucher: spent first, never withdrawable, and therefore worth
     * nothing to a wallet farm. The milestones are the second layer — an idle
     * farmed wallet never collects the larger half.
     */
    uint256 public constant STARTER_GRANT_STAKE = 200 ether;
    uint256 public constant STARTER_GRANT_CLAIM = 300 ether;
    /// @dev capped budget of its own, so onboarding never dilutes MINING_POOL
    uint256 public constant ONBOARDING_POOL = 500 ether * 2000;

    uint8 private constant STARTER_OPENED = 1;
    uint8 private constant STARTER_STAKED = 2;
    uint8 private constant STARTER_CLAIMED = 4;

    /* ---------------------------------------------------------- STORAGE */

    SquirrelGame public game;
    QBTC public qbtc;

    /// @dev emission clock origin
    uint256 public immutable genesis;

    mapping(uint256 => Rig) public rigs;
    mapping(uint256 => Guard[]) public drey;   // alpha => guards
    mapping(uint256 => uint256) public dreyIndices;

    /**
     * Yield that has settled but not left the game.
     *
     * Spendable on coolant, repairs, acorns, patches, firewalls and forge fees
     * the moment it lands, with no clock and nothing to reset. It is contract
     * state rather than a token, so no third-party wallet can see it — which is
     * why every movement emits an event and the lens reports the balance.
     */
    mapping(address => uint256) public credit;
    /// @dev the onboarding voucher: spent before `credit`, never withdrawable
    mapping(address => uint256) public starterCredit;
    /// @dev bitfield of STARTER_OPENED / _STAKED / _CLAIMED
    mapping(address => uint8) public starterFlags;
    uint256 public onboardingPaid;

    mapping(address => Withdrawal) public exiting;
    mapping(address => ExitCommit) public exitCommits;
    uint256 public commitNonce;

    /// @dev contracts allowed to debit credit on a player's behalf
    mapping(address => bool) public spenders;

    /// @dev staked token ids per owner, so nobody has to replay the event log
    mapping(address => uint16[]) private stakedIds;
    /// @dev tokenId => index into stakedIds[owner], offset by one so 0 is absent
    mapping(uint256 => uint256) private stakedSlot;

    /// @dev cumulative qBTC per unit of hashrate, scaled by PRECISION
    uint256 public accPerHash;
    /// @dev sum of recorded hashrate contributions of staked rigs
    uint256 public totalHashrate;
    uint256 public lastAccUpdate;

    uint256 public totalAlphaStaked;
    uint256 public totalRigsStaked;
    uint256 public qbtcPerAlpha;
    uint256 public unaccountedTax;

    /// @dev counts against Ops.MINING_POOL
    uint256 public totalMined;
    uint256 public totalBurned;

    /**
     * A rig ships with one charged coolant cell, granted once per token.
     *
     * Without it a new player is deadlocked: fuel costs qBTC, and qBTC only
     * comes from mining, which needs fuel. Granting it per token rather than
     * per stake stops the obvious cycle of unstaking and restaking for free
     * coolant.
     */
    mapping(uint256 => bool) public primed;
    uint256 public constant PRIMING_WINDOW = 1 days;

    /**
     * Per-season, per-NFT ladder scores.
     *
     * Keyed by season so nothing ever needs resetting, and scored per NFT
     * rather than per wallet — splitting a fleet across wallets leaves both the
     * scores and the totals identical, so Sybil gains nothing.
     *
     * `mined` is gross qBTC produced. `uptime` is seconds spent actually
     * mining, unweighted by hashrate, so a well-tended but damaged rig can
     * still top the Operators ladder while scoring poorly on Miners.
     */
    mapping(uint256 => mapping(uint256 => uint256)) public rigSeasonMined;
    mapping(uint256 => mapping(uint256 => uint256)) public rigSeasonUptime;
    mapping(uint256 => uint256) public seasonMinedTotal;
    mapping(uint256 => uint256) public seasonUptimeTotal;

    /// @dev authorised to drain a rig's settled yield on a successful raid
    address public raidPost;

    /// @dev swappable table turning cosmetic traits into mechanical ones
    ITraitStats public stats;

    bool public rescueEnabled;

    /* ----------------------------------------------------------- EVENTS */

    event RigStaked(address indexed owner, uint256 indexed tokenId);
    event GuardStaked(address indexed owner, uint256 indexed tokenId, uint256 alpha);
    event Refuelled(uint256 indexed tokenId, uint256 until_, uint256 cost);
    event Repaired(uint256 indexed tokenId, uint8 from, uint256 cost);
    event Mined(uint256 indexed tokenId, uint256 gross, uint256 tax, uint256 net);
    event Fed(uint256 indexed tokenId, uint8 energy, uint256 cost);
    /// @dev credit is invisible to explorers and third-party wallets; these
    /// four events are what lets an indexer rebuild a balance from the chain
    event CreditEarned(address indexed owner, uint256 amount, uint256 balance);
    event CreditSpent(address indexed owner, uint256 amount, uint256 fromCredit);
    event WithdrawRequested(address indexed owner, uint256 amount, uint64 revealBlock);
    event WithdrawReanchored(address indexed owner, uint64 revealBlock);
    event WithdrawSettled(address indexed owner, uint256 amount, uint256 paid, bool won);
    event StarterOpened(address indexed owner);
    event StarterGranted(address indexed owner, uint256 amount, uint256 balance);
    event ExitCommitted(address indexed owner, uint256 count, uint64 revealBlock);
    event ExitSettled(address indexed owner, uint256 earned, uint256 stolen);
    event StreakBroken(uint256 indexed tokenId, uint32 hadDays);

    constructor(address _game, address _qbtc) {
        game = SquirrelGame(_game);
        qbtc = QBTC(_qbtc);
        genesis = block.timestamp;
        lastAccUpdate = block.timestamp;
    }

    /* ------------------------------------------------------- ACCOUNTING */

    /**
     * Advances the global accumulator.
     *
     * `totalHashrate` holds each rig's hashrate as recorded at its last
     * settlement, which is an over-estimate once durability has decayed. That
     * makes the denominator too large and the distribution slightly
     * conservative — the shortfall is simply never minted, and the contract can
     * never over-issue against the pool.
     *
     * The accumulator also ignores trait modifiers, while each rig claims its
     * share multiplied by `hashrateBps`, so the sum of per-rig claims drifts
     * from what the accumulator budgeted. That drift is intended, not a bug:
     * it stays bounded by the MINING_POOL headroom clamp in `_settleRig`, and
     * since TraitStats now rolls below neutral as well as above, harmful rolls
     * pull it back the other way and narrow it.
     */
    function _updateAcc() internal {
        if (block.timestamp <= lastAccUpdate) return;
        if (totalHashrate > 0) {
            uint256 emission = Ops.emissionBetween(
                lastAccUpdate - genesis,
                block.timestamp - genesis
            );
            uint256 headroom = Ops.MINING_POOL > totalMined ? Ops.MINING_POOL - totalMined : 0;
            if (emission > headroom) emission = headroom;
            if (emission > 0) {
                accPerHash += (emission * Ops.PRECISION) / totalHashrate;
            }
        }
        lastAccUpdate = block.timestamp;
    }

    modifier settles() {
        _updateAcc();
        _;
    }

    function seasonNow() public view returns (uint256) {
        return Ops.seasonOf(block.timestamp - genesis);
    }

    /**
     * What one full-hashrate rig would earn in a day at the current rate.
     *
     * This is the reference price for coolant, repairs, acorns and firewalls,
     * so the denominator is floored at one full rig. Dividing by the raw
     * `totalHashrate` would send every price to zero the moment the last
     * staked rig hit zero durability — letting a player run a fleet into the
     * ground and then revive it for nothing.
     */
    function fullRateDailyYield() public view returns (uint256) {
        uint256 denom = totalHashrate < Ops.PRECISION ? Ops.PRECISION : totalHashrate;
        uint256 perSecond = Ops.seasonRate(Ops.seasonOf(block.timestamp - genesis));
        return (perSecond * 1 days * Ops.PRECISION) / denom;
    }

    /* ----------------------------------------------------------- STAKING */

    function stake(uint16[] calldata tokenIds) external whenNotPaused nonReentrant settles {
        for (uint256 i = 0; i < tokenIds.length; i++) {
            uint16 id = tokenIds[i];
            if (id == 0) continue;
            require(game.ownerOf(id) == _msgSender(), "Not your token");
            game.transferFrom(_msgSender(), address(this), id);
            _stakeOne(_msgSender(), id);
        }
    }

    /// @dev called by SquirrelGame when a mint is staked directly
    function addManyToFarmAndDrey(address account, uint16[] calldata tokenIds)
        external
        settles
    {
        require(_msgSender() == address(game), "Only the collection");
        for (uint256 i = 0; i < tokenIds.length; i++) {
            if (tokenIds[i] == 0) continue; // slot skipped by a stolen mint
            _stakeOne(account, tokenIds[i]);
        }
    }

    function _stakeOne(address account, uint16 id) internal {
        _track(account, id);
        _grant(account, STARTER_STAKED, STARTER_GRANT_STAKE);
        if (game.getTokenTraits(id).isQuantum) {
            // A rig enters at full durability but with no fuel: it earns
            // nothing until its owner pays for coolant.
            rigs[id] = Rig({
                owner: account,
                tokenId: id,
                durability: Ops.DURABILITY_MAX,
                lastSettled: uint40(block.timestamp),
                streakDays: 0,
                fuelExpiry: uint40(block.timestamp + (primed[id] ? 0 : PRIMING_WINDOW)),
                lastStreakDay: uint40(block.timestamp / 1 days),
                stakedAt: uint40(block.timestamp),
                rewardDebt: uint128(accPerHash)
            });
            primed[id] = true;
            totalHashrate += Ops.hashrateMultiplier(Ops.DURABILITY_MAX);
            totalRigsStaked += 1;
            emit RigStaked(account, id);
        } else {
            uint256 alpha = _alphaFor(id);
            totalAlphaStaked += alpha;
            dreyIndices[id] = drey[alpha].length;
            drey[alpha].push(Guard({
                owner: account,
                tokenId: id,
                energy: Ops.ENERGY_MAX,
                lastSettled: uint40(block.timestamp),
                patchSeason: uint32(seasonNow()),
                taxDebt: uint128(qbtcPerAlpha)
            }));
            emit GuardStaked(account, id, alpha);
        }
    }

    /* ------------------------------------------------------------- RIGS */

    /**
     * Settles a rig's mining up to now, then returns what it earned net of tax.
     *
     * Earnings stop at `fuelExpiry`, so an unfuelled rig accrues nothing. The
     * accumulator delta is prorated by the fuelled share of the elapsed window;
     * with prepayment capped at 7 days that window is short enough for the
     * approximation to stay tight.
     */
    function _settleRig(Rig storage r) internal returns (uint256 net) {
        uint256 from = r.lastSettled;
        uint256 to = block.timestamp;
        if (to <= from) return 0;

        uint256 fuelledTo = r.fuelExpiry < to ? r.fuelExpiry : to;
        if (fuelledTo > from && r.durability > 0) {
            uint256 fuelled = fuelledTo - from;
            ITraitStats.RigMods memory mods = _rigMods(r.tokenId);
            uint256 avgHash = (Ops.averageHashrate(r.durability, fuelled) * mods.hashrateBps) / 10000;
            uint256 streak = Ops.streakMultiplier(r.streakDays);

            uint256 accDelta = accPerHash - r.rewardDebt;
            uint256 gross = (accDelta * avgHash) / Ops.PRECISION;
            // prorate to the fuelled share of the window
            gross = (gross * fuelled) / (to - from);
            // streak bonus, capped at +25%
            gross = (gross * streak) / Ops.PRECISION;

            uint256 headroom = Ops.MINING_POOL > totalMined ? Ops.MINING_POOL - totalMined : 0;
            if (gross > headroom) gross = headroom;

            if (gross > 0) {
                totalMined += gross;
                uint256 tax = (gross * Ops.TAX_PCT) / 100;
                _payDrey(tax);
                net = gross - tax;
                emit Mined(r.tokenId, gross, tax, net);
            }

            // ladder scores for the season this settlement falls in
            uint256 season = seasonNow();
            if (gross > 0) {
                rigSeasonMined[season][r.tokenId] += gross;
                seasonMinedTotal[season] += gross;
            }
            rigSeasonUptime[season][r.tokenId] += fuelled;
            seasonUptimeTotal[season] += fuelled;

            // durability only decays while actually mining
            // a sturdier chassis and a higher generation both slow wear
            _setDurability(r, Ops.decayed(r.durability, (fuelled * mods.decayBps) / 10000));
        }

        r.lastSettled = uint40(to);
        r.rewardDebt = uint128(accPerHash);
    }

    /**
     * Writes durability and keeps `totalHashrate` in step.
     *
     * A rig's contribution tracks durability alone, not whether it currently
     * has fuel. An unfuelled rig therefore keeps inflating the denominator
     * until someone settles it, which under-distributes to everyone else — the
     * shortfall is simply never minted. The alternative, zeroing the
     * contribution the instant fuel lapses, would need a keeper to notice the
     * lapse, since nothing on chain fires at an expiry.
     */
    function _setDurability(Rig storage r, uint8 next) internal {
        uint256 was = Ops.hashrateMultiplier(r.durability);
        uint256 now_ = Ops.hashrateMultiplier(next);
        if (now_ > was) totalHashrate += (now_ - was);
        else if (was > now_) totalHashrate -= (was - now_);
        r.durability = next;
    }

    /**
     * Buys coolant for `duration`, up to 7 days ahead, and settles first.
     *
     * The original design allowed only a 24-hour window, which forced every
     * player on chain daily for no gameplay benefit. Prepaying a week costs the
     * same per day and cuts refuelling gas by 86%.
     */
    function refuel(uint16[] calldata tokenIds, uint256 duration)
        external
        whenNotPaused
        nonReentrant
        settles
    {
        require(duration > 0 && duration <= Ops.MAX_PREPAY, "Window must be 1s to 7 days");
        uint256 daily = fullRateDailyYield();
        uint256 owed;
        uint256 cost;

        for (uint256 i = 0; i < tokenIds.length; i++) {
            Rig storage r = rigs[tokenIds[i]];
            require(r.owner == _msgSender(), "Not your rig");
            owed += _settleRig(r);
            _bumpStreak(r);

            uint256 c = (Ops.coolantCost(duration, daily) * _rigMods(r.tokenId).coolantBps) / 10000;
            cost += c;
            uint256 base = r.fuelExpiry > block.timestamp ? r.fuelExpiry : block.timestamp;
            r.fuelExpiry = uint40(base + duration);
            emit Refuelled(r.tokenId, r.fuelExpiry, c);
        }

        _credit(_msgSender(), owed);
        _spend(_msgSender(), cost);
    }

    function repair(uint16[] calldata tokenIds)
        external
        whenNotPaused
        nonReentrant
        settles
    {
        uint256 daily = fullRateDailyYield();
        uint256 owed;
        uint256 cost;

        for (uint256 i = 0; i < tokenIds.length; i++) {
            Rig storage r = rigs[tokenIds[i]];
            require(r.owner == _msgSender(), "Not your rig");
            owed += _settleRig(r);

            uint8 before = r.durability;
            cost += (Ops.repairCost(before, daily) * _rigMods(r.tokenId).repairBps) / 10000;
            _setDurability(r, Ops.DURABILITY_MAX);
            emit Repaired(r.tokenId, before, cost);
        }

        _credit(_msgSender(), owed);
        _spend(_msgSender(), cost);
    }

    /**
     * Settles yield into spendable credit without unstaking. No random outcome
     * here — the draw belongs on `requestWithdraw`, where leaving the game is
     * the player's own decision.
     */
    function claim(uint16[] calldata tokenIds)
        external
        whenNotPaused
        nonReentrant
        settles
    {
        uint256 owed;
        for (uint256 i = 0; i < tokenIds.length; i++) {
            uint16 id = tokenIds[i];
            if (game.getTokenTraits(id).isQuantum) {
                Rig storage r = rigs[id];
                require(r.owner == _msgSender(), "Not your rig");
                owed += _settleRig(r);
            } else {
                owed += _settleGuard(id, _msgSender());
            }
        }
        _credit(_msgSender(), owed);
        _grant(_msgSender(), STARTER_CLAIMED, STARTER_GRANT_CLAIM);
    }

    /**
     * Uptime streak: one point per consecutive day serviced while the rig is
     * healthy. Capped at 25 days by Ops.streakMultiplier — an uncapped streak
     * compounds into exactly the permanent early-player advantage that seasonal
     * decay exists to remove.
     */
    function _bumpStreak(Rig storage r) internal {
        uint40 today = uint40(block.timestamp / 1 days);
        if (today == r.lastStreakDay) return;
        if (today == r.lastStreakDay + 1 && r.durability >= 75) {
            r.streakDays += 1;
        } else {
            if (r.streakDays > 0) emit StreakBroken(r.tokenId, r.streakDays);
            r.streakDays = r.durability >= 75 ? 1 : 0;
        }
        r.lastStreakDay = today;
    }

    /* ----------------------------------------------------------- GUARDS */

    function _settleGuard(uint16 id, address owner) internal returns (uint256 net) {
        uint256 alpha = _alphaFor(id);
        Guard storage g = drey[alpha][dreyIndices[id]];
        require(g.owner == owner, "Not your squirrel");

        ITraitStats.SquirrelMods memory mods = _squirrelMods(id);

        // better gear stretches a charge further, so energy drains slower
        uint256 elapsed = ((block.timestamp - g.lastSettled) * mods.energyBps) / 10000;
        g.energy = Ops.energyAfter(g.energy, elapsed);

        // energy gates the share, an unpatched rank erodes it, and headgear
        // widens whatever survives both
        uint256 share = Ops.taxShareMultiplier(g.energy);
        uint256 season = seasonNow();
        uint256 rank = Ops.rankMultiplier(
            season > g.patchSeason ? season - g.patchSeason : 0
        );
        uint256 owed = alpha * (qbtcPerAlpha - g.taxDebt);
        net = (((owed * share) / Ops.PRECISION) * rank) / Ops.PRECISION;
        net = (net * mods.taxBps) / 10000;

        // the portion an exhausted squirrel forfeits stays with the Drey
        if (owed > net) _payDrey(owed - net);

        g.taxDebt = uint128(qbtcPerAlpha);
        g.lastSettled = uint40(block.timestamp);
    }

    /// @dev restore acorn energy; the qBTC spent is burned
    function feed(uint16[] calldata tokenIds) external whenNotPaused nonReentrant settles {
        uint256 daily = fullRateDailyYield();
        uint256 cost;
        uint256 owed;

        for (uint256 i = 0; i < tokenIds.length; i++) {
            uint16 id = tokenIds[i];
            owed += _settleGuard(id, _msgSender());
            Guard storage g = drey[_alphaFor(id)][dreyIndices[id]];
            cost += Ops.acornCost(g.energy, daily);
            g.energy = Ops.ENERGY_MAX;
            emit Fed(id, g.energy, cost);
        }

        _credit(_msgSender(), owed);
        _spend(_msgSender(), cost);
    }

    /**
     * Restores a squirrel's defence rank. The qBTC spent is burned.
     *
     * Without this, rank erodes 10% of tax share per season down to a 50%
     * floor, so holding a position requires reinvesting rather than only
     * collecting.
     */
    function patch(uint16[] calldata tokenIds) external whenNotPaused nonReentrant settles {
        uint256 daily = fullRateDailyYield();
        uint256 season = seasonNow();
        uint256 cost;
        uint256 owed;

        for (uint256 i = 0; i < tokenIds.length; i++) {
            uint16 id = tokenIds[i];
            owed += _settleGuard(id, _msgSender());
            Guard storage g = drey[_alphaFor(id)][dreyIndices[id]];
            cost += Ops.patchCost(season > g.patchSeason ? season - g.patchSeason : 0, daily);
            g.patchSeason = uint32(season);
        }

        _credit(_msgSender(), owed);
        _spend(_msgSender(), cost);
    }

    /**
     * Settles a rig and hands `bps` of the result to a successful raider.
     *
     * Restricted to the raid post so raid resolution — which is random and
     * therefore commit-revealed — stays in one place, while the yield
     * accounting it touches stays here.
     */
    function raidDrain(uint16 tokenId, uint256 bps, address raider)
        external
        nonReentrant
        settles
        returns (uint256 taken)
    {
        require(_msgSender() == raidPost, "Only the raid post");
        require(bps <= 10000, "Share out of range");
        Rig storage r = rigs[tokenId];
        require(r.owner != address(0), "Rig not staked");

        uint256 net = _settleRig(r);
        taken = (net * bps) / 10000;
        _credit(raider, taken);
        if (net > taken) _credit(r.owner, net - taken);
    }

    function rigOwner(uint16 tokenId) external view returns (address) {
        return rigs[tokenId].owner;
    }

    /// @dev whole days staked without interruption; resets if the rig leaves
    function stakedDays(uint16 tokenId) external view returns (uint256) {
        Rig storage r = rigs[tokenId];
        if (r.owner == address(0)) return 0;
        return (block.timestamp - r.stakedAt) / 1 days;
    }

    /// @dev neutral modifiers when no stats table is wired, so the farm still runs
    function _rigMods(uint256 tokenId) internal view returns (ITraitStats.RigMods memory m) {
        if (address(stats) == address(0)) return ITraitStats.RigMods(10000, 10000, 10000, 10000);
        return stats.rigMods(tokenId);
    }

    function _squirrelMods(uint256 tokenId)
        internal
        view
        returns (ITraitStats.SquirrelMods memory m)
    {
        if (address(stats) == address(0)) {
            return ITraitStats.SquirrelMods(10000, 10000, 10000, 10000);
        }
        return stats.squirrelMods(tokenId);
    }

    function guardOwner(uint16 tokenId) external view returns (address, uint8) {
        Guard storage g = drey[_alphaFor(tokenId)][dreyIndices[tokenId]];
        uint256 elapsed = block.timestamp - g.lastSettled;
        return (g.owner, Ops.energyAfter(g.energy, elapsed));
    }

    /// @dev spends raid energy; only the raid post may call it
    function spendEnergy(uint16 tokenId, uint8 amount) external returns (uint8 left) {
        require(_msgSender() == raidPost, "Only the raid post");
        Guard storage g = drey[_alphaFor(tokenId)][dreyIndices[tokenId]];
        uint256 elapsed = block.timestamp - g.lastSettled;
        uint8 energy = Ops.energyAfter(g.energy, elapsed);
        require(energy >= amount, "Not enough acorn energy");
        g.energy = energy - amount;
        g.lastSettled = uint40(block.timestamp);
        return g.energy;
    }

    function alphaOf(uint16 tokenId) external view returns (uint8) {
        return _alphaFor(tokenId);
    }

    function _payDrey(uint256 amount) internal {
        if (amount == 0) return;
        if (totalAlphaStaked == 0) {
            unaccountedTax += amount;
            return;
        }
        qbtcPerAlpha += (amount + unaccountedTax) / totalAlphaStaked;
        unaccountedTax = 0;
    }

    /* ----------------------------------------------------------- CREDIT */

    function _credit(address account, uint256 amount) internal {
        if (amount == 0) return;
        uint256 balance = credit[account] + amount;
        credit[account] = balance;
        emit CreditEarned(account, amount, balance);
    }

    /**
     * Debits the voucher first, then earned credit, then the ERC-20 balance.
     *
     * The order is what makes the voucher a voucher: it can only ever leave by
     * being consumed inside the game, so a farmed starter pack yields nothing
     * extractable. Every path here is a sink, so the whole amount counts
     * against `totalBurned` whether or not a token existed to burn.
     */
    function _spend(address account, uint256 amount) internal {
        if (amount == 0) return;
        uint256 left = _drawCredit(account, amount);
        if (left > 0) qbtc.burn(account, left);
        totalBurned += amount;
        emit CreditSpent(account, amount, amount - left);
    }

    /// @return left the part of `amount` no credit balance could cover
    function _drawCredit(address account, uint256 amount) internal returns (uint256 left) {
        left = amount;
        uint256 v = starterCredit[account];
        if (v > 0) {
            uint256 use = v < left ? v : left;
            starterCredit[account] = v - use;
            left -= use;
        }
        if (left == 0) return 0;
        uint256 c = credit[account];
        if (c > 0) {
            uint256 use = c < left ? c : left;
            credit[account] = c - use;
            left -= use;
        }
    }

    /**
     * Lets another game contract charge a fee against credit.
     *
     * Restricted to a whitelist rather than open, because credit is not a token
     * and there is no allowance to check. The caller burns whatever this could
     * not cover from the player's wallet balance itself.
     */
    function spendCredit(address account, uint256 amount)
        external
        returns (uint256 covered)
    {
        require(spenders[_msgSender()], "Not a game contract");
        covered = amount - _drawCredit(account, amount);
        if (covered == 0) return 0;
        totalBurned += covered;
        emit CreditSpent(account, covered, covered);
    }

    /* -------------------------------------------------------- ONBOARDING */

    /// @dev opened by the collection when a player buys their starter pack
    function openStarterCredit(address account) external {
        require(_msgSender() == address(game), "Only the collection");
        require(starterFlags[account] == 0, "Already started");
        starterFlags[account] = STARTER_OPENED;
        emit StarterOpened(account);
    }

    /// @dev pays one milestone of the onboarding grant, once, within the pool
    function _grant(address account, uint8 bit, uint256 amount) internal {
        uint8 f = starterFlags[account];
        if (f & STARTER_OPENED == 0 || f & bit != 0) return;
        starterFlags[account] = f | bit;

        uint256 room = ONBOARDING_POOL > onboardingPaid ? ONBOARDING_POOL - onboardingPaid : 0;
        if (amount > room) amount = room;
        if (amount == 0) return;

        onboardingPaid += amount;
        uint256 balance = starterCredit[account] + amount;
        starterCredit[account] = balance;
        emit StarterGranted(account, amount, balance);
    }

    /* -------------------------------------------------------- WITHDRAWAL */

    /// @dev the share of a draw that is guaranteed regardless of the coin flip
    function withdrawFloorBps(uint256 elapsed) public pure returns (uint256) {
        if (elapsed >= WITHDRAW_WINDOW) return WITHDRAW_FLOOR_END;
        return WITHDRAW_FLOOR_START
            + ((WITHDRAW_FLOOR_END - WITHDRAW_FLOOR_START) * elapsed) / WITHDRAW_WINDOW;
    }

    /**
     * Step 1 of 2 — move credit out of the game and start the odds clock.
     *
     * One request at a time, mirroring `exitCommits`. Tranches still work, they
     * just run sequentially, and each one runs its own clock from the moment it
     * was asked for.
     */
    function requestWithdraw(uint256 amount) external whenNotPaused nonReentrant {
        require(amount > 0, "Nothing to withdraw");
        require(exiting[_msgSender()].amount == 0, "Settle your pending withdrawal");
        require(amount <= MAX_WITHDRAW_PER_DRAW, "Above the per-draw cap");

        uint256 balance = credit[_msgSender()];
        require(
            amount <= (balance * MAX_WITHDRAW_SHARE_BPS) / 10000,
            "Above a quarter of your credit"
        );
        credit[_msgSender()] = balance - amount;

        uint64 rb = CommitReveal.targetBlock();
        exiting[_msgSender()] = Withdrawal({
            amount: uint128(amount),
            start: uint40(block.timestamp),
            revealBlock: rb,
            salt: CommitReveal.salt(_msgSender(), commitNonce++)
        });
        emit WithdrawRequested(_msgSender(), amount, rb);
    }

    /**
     * Step 2 of 2 — draw, and pay the floor plus whatever the flip awards.
     *
     * Permissionless, like every other reveal here, so a keeper or the app can
     * finish a draw on the player's behalf.
     *
     * A dead anchor is re-taken in place and the call returns without paying:
     * the odds clock in `start` is never touched, so waiting three days for
     * better terms costs the player one extra press of the same button rather
     * than a separate function they have to learn about.
     */
    function settleWithdraw(address owner) public whenNotPaused nonReentrant {
        Withdrawal storage w = exiting[owner];
        require(w.amount > 0, "No pending withdrawal");

        if (CommitReveal.isExpired(w.revealBlock)) {
            w.revealBlock = CommitReveal.targetBlock();
            w.salt = CommitReveal.salt(owner, commitNonce++);
            emit WithdrawReanchored(owner, w.revealBlock);
            return;
        }

        uint256 seed = CommitReveal.seed(w.revealBlock, w.salt);
        uint256 amount = w.amount;
        uint256 guaranteed = (amount * withdrawFloorBps(block.timestamp - w.start)) / 10000;
        delete exiting[owner];

        bool won = seed % 10000 < WITHDRAW_DRAW_BPS;
        uint256 paid = won ? amount : guaranteed;
        if (paid > 0) qbtc.mint(owner, paid);
        _forfeit(amount - paid);

        emit WithdrawSettled(owner, amount, paid, won);
    }

    function settleWithdraw() external {
        settleWithdraw(_msgSender());
    }

    /// @dev half of a lost draw is burned, half feeds the Drey
    function _forfeit(uint256 lost) internal {
        if (lost == 0) return;
        uint256 burned = (lost * WITHDRAW_LOSS_BURN_BPS) / 10000;
        totalBurned += burned;
        _payDrey(lost - burned);
    }


    /* ------------------------------------------------------------- EXIT */

    /// @dev step 1 of 2; the 50/50 roll is pledged to a future block hash
    function requestExit(uint16[] calldata tokenIds) external whenNotPaused nonReentrant {
        require(tokenIds.length > 0, "Nothing to exit");
        require(exitCommits[_msgSender()].tokenIds.length == 0, "Settle your pending exit");

        for (uint256 i = 0; i < tokenIds.length; i++) {
            uint16 id = tokenIds[i];
            if (game.getTokenTraits(id).isQuantum) {
                Rig storage r = rigs[id];
                require(r.owner == _msgSender(), "Not your rig");
                require(block.timestamp - r.stakedAt >= MINIMUM_TO_EXIT, "Two-day minimum");
            } else {
                require(drey[_alphaFor(id)][dreyIndices[id]].owner == _msgSender(), "Not yours");
            }
        }

        uint64 rb = CommitReveal.targetBlock();
        exitCommits[_msgSender()] = ExitCommit({
            tokenIds: tokenIds,
            revealBlock: rb,
            salt: CommitReveal.salt(_msgSender(), commitNonce++)
        });
        emit ExitCommitted(_msgSender(), tokenIds.length, rb);
    }

    /// @dev step 2 of 2; permissionless, and the outcome was fixed at commit
    function executeExit(address owner) public whenNotPaused nonReentrant settles {
        ExitCommit memory c = exitCommits[owner];
        require(c.tokenIds.length > 0, "No pending exit");

        uint256 seed = CommitReveal.seed(c.revealBlock, c.salt);
        delete exitCommits[owner];

        uint256 owed;
        uint256 stolen;

        for (uint256 i = 0; i < c.tokenIds.length; i++) {
            uint16 id = c.tokenIds[i];
            if (game.getTokenTraits(id).isQuantum) {
                Rig storage r = rigs[id];
                uint256 net = _settleRig(r);
                if (CommitReveal.derive(seed, i) & 1 == 1) {
                    // same split as a lost withdrawal draw, for the same
                    // reason: paying the Drey in full refunds a whale most of
                    // their own loss and would just move the hole here
                    _forfeit(net);
                    stolen += net;
                    net = 0;
                }
                owed += net;

                totalHashrate -= Ops.hashrateMultiplier(r.durability);
                totalRigsStaked -= 1;
                delete rigs[id];
                _untrack(owner, id);
                game.transferFrom(address(this), owner, id);
            } else {
                owed += _settleGuard(id, owner);
                uint256 alpha = _alphaFor(id);
                totalAlphaStaked -= alpha;
                Guard memory last = drey[alpha][drey[alpha].length - 1];
                drey[alpha][dreyIndices[id]] = last;
                dreyIndices[last.tokenId] = dreyIndices[id];
                drey[alpha].pop();
                delete dreyIndices[id];
                _untrack(owner, id);
                game.transferFrom(address(this), owner, id);
            }
        }

        _credit(owner, owed);
        emit ExitSettled(owner, owed, stolen);
    }

    function executeExit() external {
        executeExit(_msgSender());
    }

    function reanchorExit(address owner) external {
        ExitCommit storage c = exitCommits[owner];
        require(c.tokenIds.length > 0, "No pending exit");
        require(CommitReveal.isExpired(c.revealBlock), "Still revealable");
        c.revealBlock = CommitReveal.targetBlock();
        c.salt = CommitReveal.salt(owner, commitNonce++);
    }

    /* ----------------------------------------------------------- HELPERS */

    function _alphaFor(uint256 tokenId) internal view returns (uint8) {
        return MAX_ALPHA - game.getTokenTraits(tokenId).tierIndex;
    }

    /**
     * Per-owner index of staked tokens.
     *
     * A staked token leaves the ERC-721 enumerable set, so without this the
     * only way to list a player's holdings is to replay `qrl_getLogs` from the
     * deploy block and then ask who owns each candidate. Swap-and-pop keeps
     * both writes O(1).
     */
    function _track(address account, uint16 id) internal {
        stakedIds[account].push(id);
        stakedSlot[id] = stakedIds[account].length;
    }

    function _untrack(address account, uint16 id) internal {
        uint256 slot = stakedSlot[id];
        if (slot == 0) return;
        uint16[] storage list = stakedIds[account];
        uint16 last = list[list.length - 1];
        list[slot - 1] = last;
        stakedSlot[last] = slot;
        list.pop();
        delete stakedSlot[id];
    }

    function stakedOf(address account) external view returns (uint16[] memory) {
        return stakedIds[account];
    }

    /// @dev alpha-weighted pick of a staked squirrel owner, for stolen mints
    function randomSquirrelOwner(uint256 seed) external view returns (address) {
        if (totalAlphaStaked == 0) return address(0x0);
        uint256 bucket = (seed & 0xFFFFFFFF) % totalAlphaStaked;
        uint256 cumulative;
        seed >>= 32;
        for (uint256 i = MAX_ALPHA - ALPHA_RANKS + 1; i <= MAX_ALPHA; i++) {
            cumulative += drey[i].length * i;
            if (bucket >= cumulative) continue;
            return drey[i][seed % drey[i].length].owner;
        }
        return address(0x0);
    }

    function rigState(uint16 tokenId)
        external
        view
        returns (uint8 durability, uint256 fuelExpiry, uint32 streakDays, bool mining)
    {
        Rig storage r = rigs[tokenId];
        uint256 fuelledTo = r.fuelExpiry < block.timestamp ? r.fuelExpiry : block.timestamp;
        uint256 window = fuelledTo > r.lastSettled ? fuelledTo - r.lastSettled : 0;
        durability = Ops.decayed(r.durability, window);
        return (durability, r.fuelExpiry, r.streakDays, block.timestamp < r.fuelExpiry && durability > 0);
    }

    /* ------------------------------------------------------------- ADMIN */

    function setRaidPost(address v) external onlyOwner { raidPost = v; }

    /// @dev whitelists a game contract to charge fees against player credit
    function setSpender(address v, bool ok) external onlyOwner { spenders[v] = ok; }

    function setStats(address v) external onlyOwner { stats = ITraitStats(v); }

    function setRescueEnabled(bool v) external onlyOwner { rescueEnabled = v; }

    function setPaused(bool v) external onlyOwner {
        if (v) _pause(); else _unpause();
    }

    function onERC721Received(address, address from, uint256, bytes calldata)
        external
        pure
        override
        returns (bytes4)
    {
        require(from == address(0x0), "Send tokens via stake()");
        return IERC721Receiver.onERC721Received.selector;
    }
}

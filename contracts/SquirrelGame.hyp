// SPDX-License-Identifier: MIT
pragma hyperion >=0.0.1;

import "./lib/openzeppelin/token/ERC721/extensions/ERC721Enumerable.hyp";
import "./lib/openzeppelin/access/Ownable.hyp";
import "./lib/openzeppelin/security/Pausable.hyp";
import "./lib/openzeppelin/security/ReentrancyGuard.hyp";
import "./lib/CommitReveal.hyp";

import "./interfaces/ISquirrelGame.hyp";
import "./interfaces/IMiningFarm.hyp";
import "./interfaces/ITraits.hyp";
import "./QBTC.hyp";

/**
 * Squirrel Game — the NFT collection.
 *
 * 50,000 tokens. The first 10,000 (Gen 0) are sold for native QRL; the
 * remaining 40,000 are bought by burning qBTC on a 175 / 350 / 700 ladder.
 * Each mint has a 10% chance of rolling a Squirrel rather than a Quantum
 * Computer, and from Gen 1 onward a 10% chance of being redirected to the
 * owner of a staked Squirrel.
 *
 * Minting is two-phase. `commitMint` reserves token IDs and takes payment;
 * `revealMint` rolls traits against a block hash that did not exist at commit
 * time. Splitting the two is what stops a caller from inspecting a roll and
 * reverting it — see lib/CommitReveal.hyp.
 */
contract SquirrelGame is ISquirrelGame, ERC721Enumerable, Ownable, Pausable, ReentrancyGuard {
    using CommitReveal for uint64;

    /// @dev Gen 0 mint price, in native QRL
    uint256 public constant MINT_PRICE = 0.069420 ether;
    /// @dev max tokens that can ever be minted
    uint256 public immutable MAX_TOKENS;
    /// @dev Gen 0 allocation, purchasable with native coin
    uint256 public PAID_TOKENS;
    /// @dev number minted so far
    uint16 public minted;
    /// @dev Squirrel tiers; tier number = TIER_COUNT - tierIndex, so index 0 = Tier 3
    uint8 public constant TIER_COUNT = 3;

    mapping(uint256 => QuantumSquirrel) public tokenTraits;
    /// @dev guarantees every token is a unique trait combination
    mapping(uint256 => uint256) public existingCombinations;

    /**
     * A paid-for mint awaiting its reveal. Token IDs and cost are fixed at
     * commit time (so supply and price cannot shift underneath the player);
     * only the traits and the recipient are decided at reveal.
     */
    struct MintCommit {
        uint16 startTokenId;
        uint16 amount;
        bool stake;
        uint64 revealBlock;
        uint256 salt;
    }

    /// @dev one outstanding commit per address
    mapping(address => MintCommit) public mintCommits;
    /// @dev monotonic, feeds the commit salt so two commits never share one
    uint256 public commitNonce;

    /**
     * Fusion generation. Minted tokens are generation 0; the forge burns two
     * of the same generation to mint one of the next.
     *
     * Forged tokens are numbered above MAX_TOKENS so they can never collide
     * with a mint, and the mint supply cap stays exactly what it says it is.
     */
    mapping(uint256 => uint8) public generation;
    uint16 public forged;
    address public fusionForge;

    /// @dev Walker alias tables; slots 0-8 are Quantum Computer, 9-17 Squirrel
    uint8[][18] public rarities;
    uint8[][18] public aliases;

    IMiningFarm public farm;
    QBTC public qbtc;
    ITraits public traits;

    event QuantumMinted(uint256 indexed tokenId, address indexed owner);
    event SquirrelMinted(uint256 indexed tokenId, address indexed owner, uint8 tier);
    event MintStolen(uint256 indexed tokenId, address indexed victim, address indexed thief);
    event MintCommitted(address indexed minter, uint16 startTokenId, uint16 amount, uint64 revealBlock);
    event MintRevealed(address indexed minter, address indexed revealer, uint16 amount);
    event MintReanchored(address indexed minter, uint64 revealBlock);

    constructor(address _qbtc, address _traits, uint256 _maxTokens)
        ERC721("Squirrel Game", "SQRL")
    {
        qbtc = QBTC(_qbtc);
        traits = ITraits(_traits);
        MAX_TOKENS = _maxTokens;
        PAID_TOKENS = _maxTokens / 5;

        // Generated by scripts/gen-traits.js — see build/trait-tables.hyp.txt.
        // Quantum Computers
        rarities[0] = [255, 192, 64, 192, 64];
        rarities[1] = [255, 102, 204, 51];
        rarities[2] = [255, 133, 225, 82];
        rarities[3] = [255, 154, 204, 82];
        rarities[4] = [255, 253, 92];
        rarities[5] = [255, 184, 225, 82];
        rarities[6] = [255];
        rarities[7] = [255, 245, 100];
        rarities[8] = [255];
        // Squirrels
        rarities[9] = [255, 166, 64, 153, 64];
        rarities[10] = [255, 133, 225, 82];
        rarities[11] = [255, 102, 204, 102];
        rarities[12] = [255, 128, 115];
        rarities[13] = [255, 215, 92];
        rarities[14] = [255, 133, 225, 82];
        rarities[15] = [255, 133, 245, 82];
        rarities[16] = [255, 133, 225, 82];
        rarities[17] = [77, 230, 255];

        aliases[0] = [0, 0, 1, 0, 2];
        aliases[1] = [0, 0, 0, 1];
        aliases[2] = [0, 0, 0, 1];
        aliases[3] = [0, 0, 0, 1];
        aliases[4] = [0, 0, 0];
        aliases[5] = [0, 0, 0, 1];
        aliases[6] = [0];
        aliases[7] = [0, 0, 0];
        aliases[8] = [0];
        aliases[9] = [0, 0, 1, 0, 2];
        aliases[10] = [0, 0, 0, 1];
        aliases[11] = [0, 0, 0, 1];
        aliases[12] = [0, 0, 1];
        aliases[13] = [0, 0, 0];
        aliases[14] = [0, 0, 0, 1];
        aliases[15] = [0, 0, 0, 1];
        aliases[16] = [0, 0, 0, 1];
        aliases[17] = [2, 2, 2];
    }

    /* ---------------------------------------------------------- MINTING */

    /**
     * Step 1 of 2 — reserve and pay for up to 10 tokens.
     *
     * Token IDs and cost are settled here so neither can move before the
     * reveal. No traits are rolled and nothing is minted yet.
     *
     * @param stake whether to send the mints straight into the MiningFarm
     */
    function commitMint(uint256 amount, bool stake) external payable whenNotPaused nonReentrant {
        require(tx.origin == _msgSender(), "Only EOA");
        require(amount > 0 && amount <= 10, "Invalid mint amount");
        require(mintCommits[_msgSender()].amount == 0, "Reveal your pending mint first");
        require(minted + amount <= MAX_TOKENS, "All tokens minted");

        if (minted < PAID_TOKENS) {
            require(minted + amount <= PAID_TOKENS, "All tokens on-sale already sold");
            require(amount * MINT_PRICE == msg.value, "Invalid payment amount");
        } else {
            require(msg.value == 0, "Only qBTC for Gen 1+");
        }

        // Reserve the IDs now so supply and the qBTC price ladder are settled
        // at commit time and cannot move between commit and reveal.
        uint16 startTokenId = minted + 1;
        uint256 totalQbtcCost = 0;
        for (uint256 i = 0; i < amount; i++) {
            totalQbtcCost += mintCost(startTokenId + i);
        }
        minted += uint16(amount);

        if (totalQbtcCost > 0) qbtc.burn(_msgSender(), totalQbtcCost);

        uint64 revealBlock = CommitReveal.targetBlock();
        mintCommits[_msgSender()] = MintCommit({
            startTokenId: startTokenId,
            amount: uint16(amount),
            stake: stake,
            revealBlock: revealBlock,
            salt: CommitReveal.salt(_msgSender(), commitNonce++)
        });

        emit MintCommitted(_msgSender(), startTokenId, uint16(amount), revealBlock);
    }

    /**
     * Step 2 of 2 — roll traits and mint against the committed block hash.
     *
     * Permissionless: anyone may reveal anyone's commit, so withholding a
     * reveal gains nothing. The seed was fixed when `revealBlock` was mined,
     * so reverting and retrying produces the same result.
     */
    function revealMint(address minter) public nonReentrant {
        MintCommit memory c = mintCommits[minter];
        require(c.amount > 0, "No pending mint");

        uint256 baseSeed = CommitReveal.seed(c.revealBlock, c.salt);
        delete mintCommits[minter];

        uint16[] memory tokenIds = c.stake ? new uint16[](c.amount) : new uint16[](0);

        for (uint256 i = 0; i < c.amount; i++) {
            uint16 tokenId = c.startTokenId + uint16(i);
            uint256 seed = CommitReveal.derive(baseSeed, i);

            QuantumSquirrel memory t = generate(tokenId, seed);
            address recipient = selectRecipient(seed, minter, tokenId);

            if (!c.stake || recipient != minter) {
                _safeMint(recipient, tokenId);
            } else {
                _safeMint(address(farm), tokenId);
                tokenIds[i] = tokenId;
            }

            if (t.isQuantum) emit QuantumMinted(tokenId, recipient);
            else emit SquirrelMinted(tokenId, recipient, TIER_COUNT - t.tierIndex);
            if (recipient != minter) emit MintStolen(tokenId, minter, recipient);
        }

        if (c.stake) farm.addManyToFarmAndDrey(minter, tokenIds);
        emit MintRevealed(minter, _msgSender(), c.amount);
    }

    /// @dev convenience wrapper for the common self-reveal case
    function revealMint() external {
        revealMint(_msgSender());
    }

    /**
     * Recovery for a commit left unrevealed past the 256-block window, after
     * which its block hash is unreachable and the tokens would be stranded.
     *
     * Re-anchoring is a fresh draw, so stalling deliberately buys one re-roll
     * at the cost of hours of delay — see lib/CommitReveal.hyp.
     */
    function reanchorMint(address minter) external {
        MintCommit storage c = mintCommits[minter];
        require(c.amount > 0, "No pending mint");
        require(CommitReveal.isExpired(c.revealBlock), "Commit still revealable");

        c.revealBlock = CommitReveal.targetBlock();
        c.salt = CommitReveal.salt(minter, commitNonce++);
        emit MintReanchored(minter, c.revealBlock);
    }

    /**
     * qBTC cost ladder: free through Gen 0, then 175 / 350 / 700 across the
     * remaining supply, stepping at 2/5 and 4/5 of MAX_TOKENS.
     *
     * Minting out the full Gen 1 supply burns 15,750,000 qBTC — 75% of the
     * 21,000,000 emission cap.
     */
    function mintCost(uint256 tokenId) public view returns (uint256) {
        if (tokenId <= PAID_TOKENS) return 0;
        if (tokenId <= (MAX_TOKENS * 2) / 5) return 175 ether;
        if (tokenId <= (MAX_TOKENS * 4) / 5) return 350 ether;
        return 700 ether;
    }

    /**
     * From Gen 1 on, a mint has a 10% chance of being redirected to the owner
     * of a staked Squirrel, chosen with probability proportional to alpha.
     *
     * Keyed off `tokenId` rather than the live `minted` counter, so it stays
     * correct regardless of what others mint between commit and reveal.
     */
    function selectRecipient(uint256 seed, address minter, uint256 tokenId)
        internal
        view
        returns (address)
    {
        if (tokenId <= PAID_TOKENS || ((seed >> 245) % 10) != 0) return minter;
        address thief = farm.randomSquirrelOwner(seed >> 144);
        if (thief == address(0x0)) return minter;
        return thief;
    }

    /* ----------------------------------------------------- TRAIT ROLLING */

    /**
     * Rolls traits, re-rolling until the combination is globally unique.
     *
     * Re-rolls advance the seed by hashing alone, never by reading chain
     * state, so the outcome stays a pure function of the committed seed. Live
     * block data here would give the revealer something to grind on.
     */
    function generate(uint256 tokenId, uint256 seed) internal returns (QuantumSquirrel memory t) {
        t = selectTraits(seed);
        uint256 hash = structToHash(t);
        if (existingCombinations[hash] == 0) {
            tokenTraits[tokenId] = t;
            existingCombinations[hash] = tokenId;
            return t;
        }
        return generate(tokenId, uint256(keccak256(abi.encodePacked(seed, tokenId))));
    }

    /**
     * Walker alias draw. Uses the low byte to pick a bucket and the high byte
     * to decide between the bucket and its alias.
     */
    function selectTrait(uint16 seed, uint8 traitType) internal view returns (uint8) {
        uint8 trait = uint8(seed) % uint8(rarities[traitType].length);
        if (seed >> 8 < rarities[traitType][trait]) return trait;
        return aliases[traitType][trait];
    }

    /// @dev 9 traits drawn from independent 16-bit windows of the seed
    function selectTraits(uint256 seed) internal view returns (QuantumSquirrel memory t) {
        t.isQuantum = (seed & 0xFFFF) % 10 != 0;
        uint8 shift = t.isQuantum ? 0 : 9;

        seed >>= 16; t.chassis   = selectTrait(uint16(seed & 0xFFFF), 0 + shift);
        seed >>= 16; t.head      = selectTrait(uint16(seed & 0xFFFF), 1 + shift);
        seed >>= 16; t.ears      = selectTrait(uint16(seed & 0xFFFF), 2 + shift);
        seed >>= 16; t.eyes      = selectTrait(uint16(seed & 0xFFFF), 3 + shift);
        seed >>= 16; t.nose      = selectTrait(uint16(seed & 0xFFFF), 4 + shift);
        seed >>= 16; t.mouth     = selectTrait(uint16(seed & 0xFFFF), 5 + shift);
        seed >>= 16; t.neck      = selectTrait(uint16(seed & 0xFFFF), 6 + shift);
        seed >>= 16; t.feet      = selectTrait(uint16(seed & 0xFFFF), 7 + shift);
        seed >>= 16; t.tierIndex = selectTrait(uint16(seed & 0xFFFF), 8 + shift);
    }

    function structToHash(QuantumSquirrel memory s) internal pure returns (uint256) {
        return uint256(keccak256(abi.encodePacked(
            s.isQuantum, s.chassis, s.head, s.ears, s.eyes,
            s.nose, s.mouth, s.neck, s.feet, s.tierIndex
        )));
    }

    /* ------------------------------------------------------------ VIEWS */

    /// @return whether `minter`'s commit can be revealed right now
    function canReveal(address minter) external view returns (bool) {
        MintCommit memory c = mintCommits[minter];
        return c.amount > 0
            && CommitReveal.isReady(c.revealBlock)
            && !CommitReveal.isExpired(c.revealBlock);
    }

    /// @return whether `minter`'s commit has aged out and needs re-anchoring
    function needsReanchor(address minter) external view returns (bool) {
        MintCommit memory c = mintCommits[minter];
        return c.amount > 0 && CommitReveal.isExpired(c.revealBlock);
    }

    function getTokenTraits(uint256 tokenId) external view override returns (QuantumSquirrel memory) {
        return tokenTraits[tokenId];
    }

    function generationOf(uint256 tokenId) external view override returns (uint8) {
        return generation[tokenId];
    }

    /* ------------------------------------------------------------- FORGE */

    /**
     * Burns a token on behalf of the forge.
     *
     * Restricted to one authorised contract: burning is irreversible and the
     * collection's supply guarantees depend on nothing else being able to do
     * it. The forge checks ownership before calling.
     */
    function forgeBurn(uint256 tokenId) external {
        require(_msgSender() == fusionForge, "Only the forge");
        delete existingCombinations[structToHash(tokenTraits[tokenId])];
        delete tokenTraits[tokenId];
        delete generation[tokenId];
        _burn(tokenId);
    }

    /**
     * Mints a fused token with traits chosen by the forge.
     *
     * Numbered above MAX_TOKENS, so fusion never competes with minting for
     * supply and `minted` stays a true count of Gen 0 and Gen 1 sales.
     */
    function forgeMint(address to, QuantumSquirrel calldata t, uint8 gen)
        external
        returns (uint256 tokenId)
    {
        require(_msgSender() == fusionForge, "Only the forge");
        forged += 1;
        tokenId = MAX_TOKENS + forged;
        tokenTraits[tokenId] = t;
        generation[tokenId] = gen;
        existingCombinations[structToHash(t)] = tokenId;
        _safeMint(to, tokenId);
    }

    function setFusionForge(address _forge) external onlyOwner {
        fusionForge = _forge;
    }

    function getPaidTokens() external view override returns (uint256) {
        return PAID_TOKENS;
    }

    function tokenURI(uint256 tokenId) public view override returns (string memory) {
        require(_exists(tokenId), "Nonexistent token");
        return traits.tokenURI(tokenId);
    }

    /* ------------------------------------------------------------ ADMIN */

    /// @dev lets the MiningFarm move staked tokens without a wasted approval
    function transferFrom(address from, address to, uint256 tokenId) public override(ERC721, IERC721) {
        if (_msgSender() != address(farm)) {
            require(_isApprovedOrOwner(_msgSender(), tokenId), "Caller is not owner nor approved");
        }
        _transfer(from, to, tokenId);
    }

    function setFarm(address _farm) external onlyOwner {
        farm = IMiningFarm(_farm);
    }

    function setTraits(address _traits) external onlyOwner {
        traits = ITraits(_traits);
    }

    function setPaidTokens(uint256 _paidTokens) external onlyOwner {
        PAID_TOKENS = _paidTokens;
    }

    function setPaused(bool _paused) external onlyOwner {
        if (_paused) _pause();
        else _unpause();
    }

    function withdraw() external onlyOwner {
        payable(owner()).transfer(address(this).balance);
    }
}

// SPDX-License-Identifier: MIT
pragma hyperion >=0.0.1;

/**
 * Operations maths: emission schedule, durability, energy, and fee pricing.
 *
 * Pure functions only — no storage and no chain reads — so every value here is
 * reproducible off chain by scripts/gdd-model.js and scripts/simulate.js.
 */
library Ops {
    uint256 internal constant PRECISION = 1e18;

    /* ------------------------------------------------------- EMISSION */

    /// @dev mining's share of the 21,000,000 cap
    uint256 internal constant MINING_POOL = 10_500_000 ether;
    uint256 internal constant SEASON_LENGTH = 30 days;

    /**
     * Emission for the whole network during season 0, per day.
     *
     * The pool decays 4% per season, so the series
     * `S0 * sum((1-d)^s)` sums to `S0 / d`. Setting `S0 = MINING_POOL * 4%`
     * makes it converge on the pool without ever exhausting it, and spreads
     * 32% of the cap over year one rather than the 75% a halving schedule
     * would front-load.
     */
    uint256 internal constant SEASON_0_EMISSION = MINING_POOL * 4 / 100;

    /// @dev per-season retention, 96% expressed as 24/25
    uint256 internal constant DECAY_NUM = 24;
    uint256 internal constant DECAY_DEN = 25;

    /// @dev past this the rate underflows to dust; also bounds every loop
    uint256 internal constant MAX_SEASON = 400;

    function seasonOf(uint256 elapsedSinceGenesis) internal pure returns (uint256) {
        uint256 s = elapsedSinceGenesis / SEASON_LENGTH;
        return s > MAX_SEASON ? MAX_SEASON : s;
    }

    /**
     * Emission rate for a season, in wei per second.
     *
     * Iterative rather than exponential so the arithmetic stays exact in
     * integers. Callers that settle regularly cross at most one season per
     * call; the loop is bounded for the case where nobody has interacted for
     * a long time.
     */
    function seasonRate(uint256 season) internal pure returns (uint256) {
        if (season > MAX_SEASON) return 0;
        uint256 perSeason = SEASON_0_EMISSION;
        for (uint256 i = 0; i < season; i++) {
            perSeason = (perSeason * DECAY_NUM) / DECAY_DEN;
            if (perSeason == 0) return 0;
        }
        return perSeason / SEASON_LENGTH;
    }

    /**
     * Total emission accrued over [from, to), integrating across season
     * boundaries so a long gap is never paid at a stale higher rate.
     *
     * Both bounds are seconds since genesis.
     */
    function emissionBetween(uint256 from, uint256 to) internal pure returns (uint256 total) {
        if (to <= from) return 0;
        uint256 cursor = from;
        for (uint256 i = 0; i < 16 && cursor < to; i++) {
            uint256 season = cursor / SEASON_LENGTH;
            if (season > MAX_SEASON) break;
            uint256 boundary = (season + 1) * SEASON_LENGTH;
            uint256 segmentEnd = boundary < to ? boundary : to;
            total += (segmentEnd - cursor) * seasonRate(season);
            cursor = segmentEnd;
        }
    }

    /* ----------------------------------------------------- DURABILITY */

    uint8 internal constant DURABILITY_MAX = 100;
    uint256 internal constant DECAY_PER_DAY = 5;
    uint8 internal constant CRITICAL_MAX = 19;

    /// @dev hashrate as a fraction of PRECISION, by remaining durability
    function hashrateMultiplier(uint256 durability) internal pure returns (uint256) {
        if (durability == 0) return 0;
        if (durability >= 75) return PRECISION;
        if (durability >= 50) return (PRECISION * 80) / 100;
        if (durability >= 20) return (PRECISION * 50) / 100;
        return (PRECISION * 20) / 100;
    }

    /// @dev durability remaining after `elapsed` seconds of mining
    function decayed(uint256 durability, uint256 elapsed) internal pure returns (uint8) {
        uint256 lost = (elapsed * DECAY_PER_DAY) / 1 days;
        if (lost >= durability) return 0;
        return uint8(durability - lost);
    }

    /**
     * Time-weighted average hashrate across a mining window.
     *
     * Durability falls monotonically, so the window crosses at most four band
     * boundaries. Integrating over those segments is bounded and cheap, and it
     * avoids both naive alternatives: charging the whole window at the opening
     * durability overpays, and charging it at the closing durability underpays
     * badly after a long gap.
     */
    function averageHashrate(uint256 startDurability, uint256 elapsed)
        internal
        pure
        returns (uint256)
    {
        if (elapsed == 0 || startDurability == 0) return 0;

        uint256 weighted;
        uint256 cursor;
        uint256 d = startDurability;
        uint8[4] memory floors = [75, 50, 20, 1];

        for (uint256 i = 0; i < 4 && cursor < elapsed && d > 0; i++) {
            uint256 floorD = floors[i];
            if (d < floorD) continue;

            uint256 points = d - (floorD - 1);
            uint256 segment = (points * 1 days) / DECAY_PER_DAY;
            uint256 remaining = elapsed - cursor;
            if (segment > remaining) segment = remaining;

            weighted += segment * hashrateMultiplier(d);
            cursor += segment;
            d = decayed(startDurability, cursor);
        }

        return weighted / elapsed;
    }

    /* ------------------------------------------------------- PRICING */

    uint256 internal constant CRYO_PCT = 10;
    uint256 internal constant TAX_PCT = 20;
    /// @dev cost per durability point, in basis points of full-rate daily yield
    uint256 internal constant REPAIR_PER_POINT_BPS = 500;
    /// @dev flat charge per repair action, in basis points
    uint256 internal constant REPAIR_SERVICE_BPS = 200;
    uint256 internal constant CRITICAL_PENALTY_NUM = 3;
    uint256 internal constant CRITICAL_PENALTY_DEN = 2;

    /**
     * Cost to restore `durability` to full.
     *
     * Priced against `fullRateDailyYield` — what the rig would earn in a day at
     * 100% durability — rather than against its actual recent output. Pricing
     * off actual output would drive repair cost to zero exactly when a rig is
     * most broken, letting a player run a machine into the ground and revive it
     * for free.
     *
     * The flat service term is what creates the maintenance decision: without
     * it cost is linear in points, so daily top-ups and bulk repairs cost the
     * same and there is nothing to choose between.
     */
    function repairCost(uint256 durability, uint256 fullRateDailyYield)
        internal
        pure
        returns (uint256)
    {
        if (durability >= DURABILITY_MAX) return 0;
        uint256 points = DURABILITY_MAX - durability;
        uint256 cost = (points * REPAIR_PER_POINT_BPS * fullRateDailyYield) / 10000;
        if (durability <= CRITICAL_MAX) {
            cost = (cost * CRITICAL_PENALTY_NUM) / CRITICAL_PENALTY_DEN;
        }
        return cost + (REPAIR_SERVICE_BPS * fullRateDailyYield) / 10000;
    }

    /* ---------------------------------------------------- COOLANT */

    uint256 internal constant MAX_PREPAY = 7 days;

    /**
     * Coolant cost for a prepaid window.
     *
     * Charged as a share of what the rig can produce over that window, never
     * as a fixed token amount: a fixed fee becomes unpayable precisely when
     * per-rig output falls, which is how these economies enter a death spiral.
     */
    function coolantCost(uint256 duration, uint256 fullRateDailyYield)
        internal
        pure
        returns (uint256)
    {
        return (duration * fullRateDailyYield * CRYO_PCT) / (1 days * 100);
    }

    /* --------------------------------------------------- DREY ENERGY */

    uint8 internal constant ENERGY_MAX = 100;
    uint256 internal constant ENERGY_DECAY_PER_DAY = 10;
    /// @dev cost per energy point, in basis points of the reference income
    uint256 internal constant ACORN_PER_POINT_BPS = 20;

    function energyAfter(uint256 energy, uint256 elapsed) internal pure returns (uint8) {
        uint256 lost = (elapsed * ENERGY_DECAY_PER_DAY) / 1 days;
        if (lost >= energy) return 0;
        return uint8(energy - lost);
    }

    /// @dev share of the tax pool a guard may draw, as a fraction of PRECISION
    function taxShareMultiplier(uint256 energy) internal pure returns (uint256) {
        if (energy >= 50) return PRECISION;
        if (energy >= 20) return PRECISION / 2;
        return 0;
    }

    function acornCost(uint256 energy, uint256 referenceIncome) internal pure returns (uint256) {
        if (energy >= ENERGY_MAX) return 0;
        return ((ENERGY_MAX - energy) * ACORN_PER_POINT_BPS * referenceIncome) / 10000;
    }

    /* ------------------------------------------------- SEASON POOLS */

    /// @dev the season ladders' share of the 21,000,000 cap
    uint256 internal constant SEASON_POOL = 5_250_000 ether;
    uint256 internal constant SEASON_0_REWARD = SEASON_POOL * 4 / 100;

    /// @dev ladder split, in basis points
    uint256 internal constant LADDER_MINERS_BPS = 4000;
    uint256 internal constant LADDER_RAIDERS_BPS = 3500;
    uint256 internal constant LADDER_OPERATORS_BPS = 2500;

    /// @dev reward budget for a whole season, decaying with the same 4% curve
    function seasonPoolFor(uint256 season) internal pure returns (uint256) {
        if (season > MAX_SEASON) return 0;
        uint256 pool = SEASON_0_REWARD;
        for (uint256 i = 0; i < season; i++) {
            pool = (pool * DECAY_NUM) / DECAY_DEN;
            if (pool == 0) return 0;
        }
        return pool;
    }

    /* ----------------------------------------------------------- RAIDS */

    uint8 internal constant RAID_ENERGY_COST = 15;
    /// @dev share of a target's settled yield a successful raid takes
    uint256 internal constant RAID_STEAL_BPS = 2500;
    /// @dev flattens the odds so a bare rig is not a free lunch
    uint256 internal constant RAID_DEFENCE_BASE = 4;
    uint8 internal constant FIREWALL_MAX = 20;
    /// @dev firewall points lost per season; defence is rented, never owned
    uint8 internal constant FIREWALL_DECAY_PER_SEASON = 1;

    /**
     * Odds a raid succeeds, scaled to PRECISION.
     *
     *     P = alpha / (alpha + firewall + base)
     *
     * A Tier 3 squirrel (alpha 8) against an undefended rig wins 8/12 = 67%;
     * against a fully upgraded firewall, 8/32 = 25%. Tier 1 (alpha 6) spans
     * 60% down to 20%, so tier matters without ever making defence pointless.
     */
    function raidOdds(uint256 alpha, uint256 firewall) internal pure returns (uint256) {
        uint256 denom = alpha + firewall + RAID_DEFENCE_BASE;
        if (denom == 0) return 0;
        return (alpha * PRECISION) / denom;
    }

    /// @dev cost of the next firewall point, priced off full-rate daily yield
    function firewallCost(uint256 current, uint256 fullRateDailyYield)
        internal
        pure
        returns (uint256)
    {
        // rises with each point so defence cannot simply be bought outright
        return ((current + 1) * 15 * fullRateDailyYield) / 100;
    }

    function firewallAfterDecay(uint256 firewall, uint256 seasonsElapsed)
        internal
        pure
        returns (uint8)
    {
        uint256 lost = seasonsElapsed * FIREWALL_DECAY_PER_SEASON;
        if (lost >= firewall) return 0;
        return uint8(firewall - lost);
    }

    /* ------------------------------------------------ DEFENCE RANK */

    /// @dev tax share lost per season without a signature patch
    uint256 internal constant RANK_DECAY_BPS = 1000;
    /// @dev decay floor; an unpatched squirrel still earns half
    uint256 internal constant RANK_FLOOR_BPS = 5000;

    /**
     * Multiplier on a squirrel's tax share, scaled to PRECISION.
     *
     * Applied at claim time rather than by lowering a stored rank: the Drey
     * buckets guards by alpha, so literally changing a rank would mean
     * migrating every staked squirrel between buckets — unbounded work that
     * cannot fit in one transaction.
     */
    function rankMultiplier(uint256 seasonsSincePatch) internal pure returns (uint256) {
        uint256 lost = seasonsSincePatch * RANK_DECAY_BPS;
        if (lost > 10000 - RANK_FLOOR_BPS) lost = 10000 - RANK_FLOOR_BPS;
        return (PRECISION * (10000 - lost)) / 10000;
    }

    /// @dev cost to restore a squirrel's rank to full
    function patchCost(uint256 seasonsSincePatch, uint256 referenceIncome)
        internal
        pure
        returns (uint256)
    {
        if (seasonsSincePatch == 0) return 0;
        uint256 seasons = seasonsSincePatch > 5 ? 5 : seasonsSincePatch;
        return (seasons * 30 * referenceIncome) / 100;
    }

    /* ---------------------------------------------------- RETENTION */

    /// @dev uptime streak: +1% hashrate per consecutive day, capped at +25%
    uint256 internal constant STREAK_BONUS_BPS = 100;
    uint256 internal constant STREAK_CAP_BPS = 2500;

    function streakMultiplier(uint256 streakDays) internal pure returns (uint256) {
        uint256 bonus = streakDays * STREAK_BONUS_BPS;
        if (bonus > STREAK_CAP_BPS) bonus = STREAK_CAP_BPS;
        return PRECISION + (PRECISION * bonus) / 10000;
    }

    /* ------------------------------------------------------ VESTING */

    uint256 internal constant VESTING_PERIOD = 7 days;

    /// @dev fraction of a claim released after `elapsed`; the rest is burned
    function vestedFraction(uint256 elapsed) internal pure returns (uint256) {
        if (elapsed >= VESTING_PERIOD) return PRECISION;
        return (elapsed * PRECISION) / VESTING_PERIOD;
    }
}
